": "The Promised Land"}, {"name": "Waitin' on a Sunny Day"}, {"name": "Brilliant Disguise"}, {"name": "Racing in the Street"}, {"name": "The Rising"}, {"name": "Last to Die"}, {"name": "Long Walk Home"}, {"name": "Badlands"}, {"name": "Out in the Street"}]}, {"encore": 1, "song": [{"name": "I'll Fly Away", "cover": {"mbid": "41a32fbd-2b1c-432c-88fe-fdcae14b4fe8", "name": "Rev. J.M. Gates", "sortName": "Gates, Rev. J.M.", "disambiguation": "", "url": "https://www.setlist.fm/setlists/rev-jm-gates-43d66717.html"}, "info": "Dedicated to Danny"}, {"name": "Rosalita (Come Out Tonight)"}, {"name": "Born to Run"}, {"name": "Tenth Avenue Freeze-Out", "info": "replaced Spirit in the Night on written setlist"}, {"name": "American Land"}]}]}, "info": "Show postponed due to the death of organ player Dan Federici. A montage of archive footage of Federici was played prior to the band appearing on stage to the song Blood Brothers, whilst his Acordian and Organ was placed at the centre of the stage with the spotlight shining on it. This mark of respect continued throughout the remainder of US leg of the tour. They then went into a very emotional rendition of Backstreets. Dan's trademark song, 4th July, Asbury Park (Sandy) was played with Roy Bittan on the accordian. Further emotional tributes were shown by playing Growin' Up and I'll Fly Away.", "url": "https://www.setlist.fm/setlist/bruce-springsteen/2008/st-pete-times-forum-tampa-fl-5bd6bfb4.html"}, {"id": "33ddccd9", "versionId": "6b02aa86", "eventDate": "21-04-2008", "lastUpdated": "2019-08-19T04:45:12.663+0000", "artist": {"mbid": "70248960-cb53-4ea4-943a-edb18f7d336f", "name": "Bruce Springsteen", "sortName": "Springsteen, Bruce", "disambiguation": "", "url": "https://www.setlist.fm/setlists/bruce-springsteen-2bd6dcce.html"}, "venue": {"id": "2bd2802e", "name": "United Methodist Church of Red Bank", "city": {"id": "5103159", "name": "Red Bank", "state": "New Jersey", "stateCode": "NJ", "coords": {"lat": 40.3470543, "long": -74